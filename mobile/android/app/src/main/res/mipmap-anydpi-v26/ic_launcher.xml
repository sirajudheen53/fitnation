<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). Background is a PNG gradient
     (ic_launcher_background); the foreground/mono layers carry the glyph.
     Pre-26 devices fall back to the legacy mipmap ICs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_mono"/>
</adaptive-icon>