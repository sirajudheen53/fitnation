# FBOS QA environment variables
# Copy to .env.qa and fill in real values:
#   cp .env.qa.example .env.qa
# NEVER commit .env.qa — keep secrets out of version control.

# ── Django ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.qa
# Generate a real key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-long-random-secret-key
DEBUG=False

# Hosts (comma-separated). nginx terminates, backend sees HTTP from proxy.
ALLOWED_HOSTS=*,localhost,127.0.0.1,34.93.81.238

# ── PostgreSQL (QA) ─────────────────────────────────────────────────────
POSTGRES_DB=fitnation_qa
POSTGRES_USER=fitnation
POSTGRES_PASSWORD=change-me-qa-db-password
# Database service is named "db" inside the compose network
DATABASE_URL=postgres://fitnation:change-me-qa-db-password@db:5432/fitnation_qa

# ── Redis (cache + sessions) ────────────────────────────────────────────
# Service is named "redis" inside the compose network
REDIS_URL=redis://redis:6379/1

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from the browser
CORS_ALLOWED_ORIGINS=http://34.93.81.238,http://localhost

# ── Frontend (Next.js) ──────────────────────────────────────────────────
# Public API base URL baked into the client bundle at build time
NEXT_PUBLIC_API_URL=http://34.93.81.238/api/v1