# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local databases — NEVER ship local SQLite into the image
db.sqlite3
db_local.sqlite3
*.sqlite3

# Local env files — build env comes from Dockerfile ARGs + Cloud Run service
# env; a developer's .env must not leak into image builds via django-environ's
# read_env()
.env

# Test / coverage artifacts
.coverage
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage.*
*.cover

# Media uploads (dev)
media/

# Git / CI
.git/
.github/

# OS / editor
.DS_Store
*.swp
